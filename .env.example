# Environment Configuration for TimeSafe Feature Pipeline
PROJECT_NAME="TimeSafe Feature Pipeline"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to local SQLite)
# For local SQLite: sqlite:///timesafe.db or sqlite:///C:/CandidateWorkspace/timesafe-feature-pipeline/timesafe.db
DATABASE_URL="sqlite:///timesafe.db"

# Future PostgreSQL / Supabase connection format:
# DATABASE_URL="postgresql://user:password@localhost:5432/timesafe"

# Data Directories
DATA_DIR="data"
RAW_DATA_DIR="data/raw"
QUARANTINE_DATA_DIR="data/quarantine"
OUTPUT_DATA_DIR="data/output"

# API & Server Configuration
API_HOST="127.0.0.1"
API_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

